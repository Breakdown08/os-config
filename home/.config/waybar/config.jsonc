{
  "layer": "top",
  "height": 28,
  // Prompter mode (Mod+Alt+P) moves the bar under the prompter strip.
  "include": ["~/.local/state/prompter/waybar.jsonc"],
  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["niri/language", "battery", "cpu", "memory", "disk", "wireplumber", "network", "custom/notifications", "tray"],
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "niri/language": { "format": "{short}" },
  "network": { "format-wifi": "{essid}", "format-ethernet": "net", "format-disconnected": "offline" },
  "battery": { "format": "bat {capacity}%" },
  "cpu": { "format": "cpu {usage}%", "interval": 5 },
  "memory": { "format": "ram {percentage}%", "interval": 5 },
  "disk": { "format": "ssd {percentage_used}%", "path": "/", "interval": 60 },
  "wireplumber": { "format": "vol {volume}%", "format-muted": "vol off" },
  "custom/notifications": {
    "exec": "~/.config/waybar/notifications.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "on-click": "makoctl mode -t do-not-disturb",
    "on-click-right": "makoctl dismiss --all"
  },
  "tray": { "spacing": 8 }
}
